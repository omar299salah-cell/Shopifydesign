<div class="page-width simple-page section-padding" style="padding-top: 32px;">
  <div class="simple-page__header">
    <h1 class="h1">{{ page.title }}</h1>
  </div>
  <div class="simple-page__content rte">
    {{ page.content }}
  </div>
</div>

{% stylesheet %}
.simple-page__header { margin-bottom: 32px; max-width: 720px; }
.simple-page__content { max-width: 720px; font-size: 1rem; line-height: 1.7; }
.simple-page__content h2 { text-transform: none; font-size: 1.375rem; margin: 32px 0 12px; letter-spacing: normal; }
.simple-page__content h3 { text-transform: none; font-size: 1.125rem; margin: 24px 0 10px; letter-spacing: normal; }
.simple-page__content p { margin: 0 0 16px; }
.simple-page__content ul, .simple-page__content ol { margin: 0 0 16px; padding-left: 20px; }
.simple-page__content a { text-decoration: underline; }
{% endstylesheet %}

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}

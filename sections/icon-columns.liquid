<section class="icon-columns section-padding" style="padding-top: 32px; padding-bottom: 32px;">
  <div class="page-width">
    <div class="icon-columns__grid">
      {%- for block in section.blocks -%}
        <div class="icon-columns__item" {{ block.shopify_attributes }}>
          <span class="icon-columns__icon" aria-hidden="true">{{ block.settings.emoji | default: '—' }}</span>
          <div>
            <p class="icon-columns__title">{{ block.settings.title }}</p>
            {%- if block.settings.text != blank -%}
              <p class="icon-columns__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.icon-columns__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  padding: 28px 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}
.icon-columns__item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}
.icon-columns__icon { font-size: 1.5rem; line-height: 1; }
.icon-columns__title {
  margin: 0;
  font-family: var(--font-heading);
  text-transform: uppercase;
  font-size: 0.8125rem;
  letter-spacing: 0.03em;
  font-weight: 700;
}
.icon-columns__text {
  margin: 4px 0 0;
  font-size: 0.8125rem;
  color: var(--color-ink-secondary);
}

@media (min-width: 750px) {
  .icon-columns__grid { grid-template-columns: repeat(4, 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Trust bar",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji / symbol", "default": "→" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Supporting text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "emoji": "🚚", "title": "Free shipping", "text": "On orders over $150" } },
        { "type": "item", "settings": { "emoji": "↺", "title": "Free returns", "text": "Within 30 days" } },
        { "type": "item", "settings": { "emoji": "🔒", "title": "Secure checkout", "text": "Encrypted payment" } },
        { "type": "item", "settings": { "emoji": "🏃", "title": "Built for runners", "text": "Tested in training" } }
      ]
    }
  ]
}
{% endschema %}

<section class="brand-story section-padding">
  <div class="page-width brand-story__grid">
    <div class="brand-story__media">
      {%- if section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" loading="lazy" width="1000" height="1250">
      {%- else -%}
        <div class="brand-story__placeholder">[PLACEHOLDER IMAGE]</div>
      {%- endif -%}
    </div>
    <div class="brand-story__content">
      <p class="eyebrow">{{ section.settings.eyebrow | default: 'Why Beyond' }}</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <div class="brand-story__text">{{ section.settings.text }}</div>
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="btn btn--primary">{{ section.settings.link_text | default: 'Our story' }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.brand-story__grid {
  display: grid;
  gap: 32px;
  align-items: center;
}
.brand-story__media {
  aspect-ratio: 4 / 5;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--color-border);
}
.brand-story__media img { width: 100%; height: 100%; object-fit: cover; }
.brand-story__placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: var(--color-ink-secondary);
  text-transform: uppercase;
  font-size: 0.75rem;
}
.brand-story__content .h2 { margin: 8px 0 16px; }
.brand-story__text { color: var(--color-ink-secondary); font-size: 1rem; line-height: 1.6; margin-bottom: 24px; max-width: 480px; }

@media (min-width: 750px) {
  .brand-story__grid { grid-template-columns: 1fr 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Beyond" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built by runners who weren't satisfied yet." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>[PLACEHOLDER — add your brand's real story: who started Beyond, what problem you set out to solve, and what makes the product different.]</p>" },
    { "type": "text", "id": "link_text", "label": "Link label", "default": "Our story" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [
    { "name": "Brand story" }
  ]
}
{% endschema %}

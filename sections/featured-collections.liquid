<section class="featured-collections section-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="featured-collections__grid">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        <a href="{{ col.url | default: '#' }}" class="featured-collections__item" {{ block.shopify_attributes }}>
          <div class="featured-collections__image">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy" width="800" height="1000">
            {%- elsif col.featured_image -%}
              <img src="{{ col.featured_image | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy" width="800" height="1000">
            {%- else -%}
              <div class="featured-collections__placeholder">[PLACEHOLDER]</div>
            {%- endif -%}
          </div>
          <span class="featured-collections__title">{{ block.settings.title | default: col.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.section-heading { margin-bottom: 32px; max-width: 560px; }
.section-heading .h2 { margin-top: 8px; }

.featured-collections__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--grid-gutter);
}
.featured-collections__item {
  position: relative;
  display: block;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.featured-collections__image {
  aspect-ratio: 4 / 5;
  background: var(--color-border);
}
.featured-collections__image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.featured-collections__item:hover .featured-collections__image img { transform: scale(1.04); }
.featured-collections__placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: var(--color-ink-secondary);
  font-size: 0.75rem;
  text-transform: uppercase;
}
.featured-collections__title {
  position: absolute;
  left: 16px;
  bottom: 16px;
  color: #fff;
  font-family: var(--font-heading);
  text-transform: uppercase;
  font-weight: 800;
  font-size: 1.125rem;
  letter-spacing: var(--heading-letter-spacing);
  text-shadow: 0 2px 12px rgba(0,0,0,0.4);
}

@media (min-width: 750px) {
  .featured-collections__grid { grid-template-columns: repeat(4, 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by activity",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by activity" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your terrain." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by activity",
      "blocks": [
        { "type": "collection", "settings": { "title": "Road" } },
        { "type": "collection", "settings": { "title": "Trail" } },
        { "type": "collection", "settings": { "title": "Racing" } },
        { "type": "collection", "settings": { "title": "Track & Field" } }
      ]
    }
  ]
}
{% endschema %}

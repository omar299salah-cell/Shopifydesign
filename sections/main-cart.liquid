<div class="page-width cart-page section-padding" style="padding-top: 32px;" data-cart-page>
  <h1 class="h2 cart-page__title">{{ 'cart.general.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="cart-page__empty">
      <p>{{ 'cart.general.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <div class="cart-page__layout">
      <ul class="cart-page__items" role="list">
        {%- for item in cart.items -%}
          <li class="cart-page__item" data-cart-item data-line="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-page__item-image">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.image.alt | escape }}" width="120" height="120" loading="lazy">
              {%- endif -%}
            </a>
            <div class="cart-page__item-details">
              <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
              {%- if item.variant.title != 'Default Title' -%}
                <p class="cart-page__item-variant">{{ item.variant.title }}</p>
              {%- endif -%}
              <button type="button" class="cart-page__item-remove-text" data-cart-remove data-line="{{ forloop.index }}">
                {{ 'cart.general.remove' | t }}
              </button>
            </div>
            <div class="qty-stepper" data-qty-stepper>
              <button type="button" data-qty-decrease aria-label="Decrease quantity">{% render 'icon', icon: 'minus', width: 12, height: 12 %}</button>
              <input type="number" min="0" value="{{ item.quantity }}" data-qty-input aria-label="{{ 'products.product.quantity' | t }}" data-line="{{ forloop.index }}">
              <button type="button" data-qty-increase aria-label="Increase quantity">{% render 'icon', icon: 'plus', width: 12, height: 12 %}</button>
            </div>
            <span class="cart-page__item-price">{{ item.final_line_price | money }}</span>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart-page__summary">
        <h2 class="h4">{{ 'cart.general.subtotal' | t }}</h2>
        <div class="cart-page__summary-row">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        {%- if settings.cart_show_shipping_note -%}
          <p class="cart-page__note">{{ 'cart.general.shipping_note' | t }}</p>
        {%- endif -%}
        <a href="{{ routes.cart_url }}/checkout" class="btn btn--accent btn--full">{{ 'cart.general.checkout' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue">{{ 'general.continue_shopping' | t }}</a>
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.cart-page__title { margin-bottom: 32px; }
.cart-page__empty { text-align: center; padding: 64px 0; display: flex; flex-direction: column; gap: 16px; align-items: center; }

.cart-page__layout { display: grid; gap: 32px; }
.cart-page__items { list-style: none; margin: 0; padding: 0; }
.cart-page__item {
  display: grid;
  grid-template-columns: 96px 1fr auto auto;
  gap: 16px;
  align-items: center;
  padding: 20px 0;
  border-bottom: 1px solid var(--color-border);
}
.cart-page__item-image { background: var(--color-bg-alt); border-radius: var(--radius-sm); overflow: hidden; }
.cart-page__item-title { font-weight: 700; }
.cart-page__item-variant { margin: 4px 0; font-size: 0.875rem; color: var(--color-ink-secondary); }
.cart-page__item-remove-text {
  background: none; border: none; padding: 0;
  font-size: 0.8125rem;
  text-decoration: underline;
  color: var(--color-ink-secondary);
}
.cart-page__item-price { font-weight: 700; }

.cart-page__summary {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24px;
  align-self: start;
}
.cart-page__summary-row { display: flex; justify-content: space-between; font-weight: 700; margin: 16px 0; }
.cart-page__note { font-size: 0.8125rem; color: var(--color-ink-secondary); margin-bottom: 16px; }
.cart-page__continue { display: block; text-align: center; margin-top: 14px; font-size: 0.875rem; text-decoration: underline; }

@media (min-width: 900px) {
  .cart-page__layout { grid-template-columns: 1fr 340px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}

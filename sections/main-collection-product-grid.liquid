<div class="page-width collection-page section-padding" style="padding-top: 32px;">

  <div class="collection-toolbar">
    <button type="button" class="collection-toolbar__filter-toggle btn btn--outline" data-filter-toggle aria-expanded="false" aria-controls="CollectionFilters">
      {{ 'collections.general.filters' | t }}
      {%- assign active_filter_count = 0 -%}
      {%- for filter in collection.filters -%}
        {%- for value in filter.values -%}
          {%- if value.active -%}{%- assign active_filter_count = active_filter_count | plus: 1 -%}{%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
      {%- if active_filter_count > 0 -%}<span class="collection-toolbar__count">{{ active_filter_count }}</span>{%- endif -%}
    </button>

    <p class="collection-toolbar__result-count">
      {{ 'collections.general.items_count' | t: count: collection.products_count }}
    </p>

    <form class="collection-toolbar__sort-form" action="{{ collection.url }}" method="get" data-sort-form>
      {%- for filter in collection.filters -%}
        {%- for value in filter.values -%}
          {%- if value.active -%}
            <input type="hidden" name="{{ filter.param_name }}" value="{{ value.value }}">
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
      <label for="SortBy" class="visually-hidden">{{ 'collections.general.sort_by' | t }}</label>
      <select name="sort_by" id="SortBy" class="collection-toolbar__sort-select" data-sort-select>
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
      <noscript><button type="submit" class="btn btn--outline">{{ 'collections.general.sort_by' | t }}</button></noscript>
    </form>
  </div>

  <div class="collection-layout">
    <aside class="collection-filters" id="CollectionFilters" data-filter-panel>
      <div class="collection-filters__header">
        <h2 class="h4">{{ 'collections.general.filter_and_sort' | t }}</h2>
        <button type="button" class="site-header__icon-btn" data-filter-toggle aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon', icon: 'close', width: 18, height: 18 %}
        </button>
      </div>

      {%- if active_filter_count > 0 -%}
        <a href="{{ collection.url }}" class="collection-filters__clear">{{ 'collections.general.clear_filters' | t }}</a>
      {%- endif -%}

      {%- for filter in collection.filters -%}
        <div class="filter-group">
          <h3 class="filter-group__title">{{ filter.label }}</h3>

          {%- if filter.type == 'price_range' -%}
            <form class="filter-price-form" action="{{ collection.url }}" method="get">
              {%- for other_filter in collection.filters -%}
                {%- unless other_filter.type == 'price_range' -%}
                  {%- for value in other_filter.values -%}
                    {%- if value.active -%}
                      <input type="hidden" name="{{ other_filter.param_name }}" value="{{ value.value }}">
                    {%- endif -%}
                  {%- endfor -%}
                {%- endunless -%}
              {%- endfor -%}
              {%- if collection.sort_by -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
              <div class="filter-price-form__row">
                <label>
                  <span class="visually-hidden">Min price</span>
                  <input type="number" name="{{ filter.min_value.param_name }}" placeholder="Min" value="{{ filter.min_value.value }}" min="0" class="field-input">
                </label>
                <span>&ndash;</span>
                <label>
                  <span class="visually-hidden">Max price</span>
                  <input type="number" name="{{ filter.max_value.param_name }}" placeholder="Max" value="{{ filter.max_value.value }}" min="0" class="field-input">
                </label>
              </div>
              <button type="submit" class="btn btn--outline btn--full filter-price-form__submit">Apply</button>
            </form>
          {%- else -%}
            <ul class="filter-group__list" role="list">
              {%- for value in filter.values -%}
                {%- assign value_href = value.url_to_add -%}
                {%- if value.active -%}{%- assign value_href = value.url_to_remove -%}{%- endif -%}
                <li>
                  <a
                    href="{{ value_href }}"
                    class="filter-value {% if value.active %}is-active{% endif %} {% if value.count == 0 %}filter-value--empty{% endif %}"
                  >
                    <span class="filter-value__box">{% if value.active %}{% render 'icon', icon: 'check', width: 11, height: 11 %}{% endif %}</span>
                    <span>{{ value.label }}</span>
                    <span class="filter-value__count">({{ value.count }})</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </aside>

    <div class="collection-grid-wrap">
      {%- if collection.products.size == 0 -%}
        <div class="collection-empty">
          <p>{{ 'collections.general.no_matches' | t }}</p>
          <a href="{{ collection.url }}" class="btn btn--primary">{{ 'collections.general.clear_filters' | t }}</a>
        </div>
      {%- else -%}
        {%- paginate collection.products by 24 -%}
          <div class="grid product-grid">
            {%- for product in collection.products -%}
              <div class="product-grid__item">
                {% render 'product-card', product: product %}
              </div>
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
.collection-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 28px;
  flex-wrap: wrap;
}
.collection-toolbar__filter-toggle { display: inline-flex; align-items: center; gap: 8px; }
.collection-toolbar__count {
  background: var(--color-accent);
  color: var(--color-accent-ink);
  border-radius: 999px;
  min-width: 18px;
  height: 18px;
  font-size: 0.6875rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 4px;
}
.collection-toolbar__result-count { margin: 0; font-size: 0.875rem; color: var(--color-ink-secondary); }
.collection-toolbar__sort-form { display: flex; }
.collection-toolbar__sort-select {
  border: 1px solid var(--color-border);
  background: var(--color-bg-alt);
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  font-size: 0.875rem;
}

.collection-layout { display: grid; gap: 32px; }

.collection-filters__header { display: none; }
.collection-filters__clear {
  display: inline-block;
  margin-bottom: 20px;
  font-size: 0.8125rem;
  text-decoration: underline;
}
.filter-group { margin-bottom: 28px; }
.filter-group__title {
  font-family: var(--font-heading);
  text-transform: uppercase;
  font-size: 0.8125rem;
  letter-spacing: 0.03em;
  margin-bottom: 12px;
}
.filter-group__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
.filter-value { display: flex; align-items: center; gap: 8px; font-size: 0.875rem; }
.filter-value__box {
  width: 16px; height: 16px;
  border: 1px solid var(--color-border);
  border-radius: 3px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.filter-value.is-active .filter-value__box { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-bg-alt); }
.filter-value__count { color: var(--color-ink-secondary); font-size: 0.8125rem; }
.filter-value--empty { opacity: 0.4; }
.filter-price-form__row { display: flex; align-items: center; gap: 8px; }
.filter-price-form__row .field-input { padding: 8px 10px; }
.filter-price-form__submit { margin-top: 10px; }

.product-grid { grid-template-columns: repeat(2, 1fr); }
.collection-empty { text-align: center; padding: 64px 0; display: flex; flex-direction: column; gap: 16px; align-items: center; }

@media (min-width: 900px) {
  .collection-layout { grid-template-columns: 240px 1fr; }
  .collection-toolbar__filter-toggle { display: none; }
  .product-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 899px) {
  .collection-filters {
    position: fixed;
    inset: 0;
    z-index: 65;
    background: var(--color-bg-alt);
    padding: 20px;
    overflow-y: auto;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
  }
  .collection-filters.is-open { transform: translateX(0); }
  .collection-filters__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection product grid",
  "settings": []
}
{% endschema %}

<div
  class="product-recommendations page-width section-padding"
  data-product-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section-heading">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="grid product-recommendations__grid">
      {%- for product in recommendations.products -%}
        <div class="product-recommendations__item">
          {% render 'product-card', product: product %}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
.product-recommendations__grid { grid-template-columns: repeat(2, 1fr); }
@media (min-width: 750px) {
  .product-recommendations__grid { grid-template-columns: repeat(4, 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "You might also like" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the kit." },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 }
  ]
}
{% endschema %}

<div class="page-width faq-page section-padding" style="padding-top: 32px;">
  <div class="simple-page__header">
    <h1 class="h1">{{ page.title | default: section.settings.heading }}</h1>
  </div>

  <div class="faq-accordion">
    {%- for block in section.blocks -%}
      <details class="faq-accordion__item" {{ block.shopify_attributes }}>
        <summary>
          {{ block.settings.question }}
          {% render 'icon', icon: 'plus', width: 14, height: 14 %}
        </summary>
        <div class="faq-accordion__answer rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
.faq-accordion { max-width: 720px; border-top: 1px solid var(--color-border); }
.faq-accordion__item { border-bottom: 1px solid var(--color-border); padding: 18px 0; }
.faq-accordion__item summary {
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 700;
  font-size: 1rem;
  list-style: none;
}
.faq-accordion__item summary::-webkit-details-marker { display: none; }
.faq-accordion__item[open] summary svg { transform: rotate(45deg); }
.faq-accordion__item summary svg { transition: transform 0.15s ease; }
.faq-accordion__answer { margin-top: 12px; color: var(--color-ink-secondary); line-height: 1.6; }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ accordion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is your return policy?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>[PLACEHOLDER — add your real policy details here.]</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "question", "settings": { "question": "How long does shipping take?" } },
      { "type": "question", "settings": { "question": "What is your return policy?" } },
      { "type": "question", "settings": { "question": "How do I find my size?" } },
      { "type": "question", "settings": { "question": "Do you ship internationally?" } }
    ]
  }
}
{% endschema %}

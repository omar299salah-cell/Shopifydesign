<section class="featured-products section-padding">
  <div class="page-width">
    <div class="section-heading section-heading--row">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="featured-products__view-all">View all →</a>
      {%- endif -%}
    </div>

    <div class="grid featured-products__grid">
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        <div class="featured-products__item">
          {% render 'product-card', product: product %}
        </div>
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="featured-products__item">
            <div class="product-card">
              <div class="product-card__media product-card__media--{{ settings.card_image_ratio }}">
                <div class="product-card__placeholder">[PLACEHOLDER PRODUCT]</div>
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
                <p class="product-card__price">$180.00</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.section-heading--row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.featured-products__view-all {
  font-family: var(--font-heading);
  text-transform: uppercase;
  font-size: 0.8125rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  white-space: nowrap;
}
.featured-products__view-all:hover { color: var(--color-accent); }
.featured-products__grid {
  grid-template-columns: repeat(2, 1fr);
}
@media (min-width: 750px) {
  .featured-products__grid { grid-template-columns: repeat(4, 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most worn on race day." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 }
  ],
  "presets": [
    { "name": "Featured products" }
  ]
}
{% endschema %}

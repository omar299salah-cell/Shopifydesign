<div class="page-width contact-page section-padding" style="padding-top: 32px;">
  <div class="simple-page__header">
    <h1 class="h1">{{ page.title | default: section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="contact-page__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- form 'contact', class: 'contact-form' -%}
    {%- if form.posted_successfully? -%}
      <p class="contact-form__success" role="status">Thanks — we'll get back to you shortly.</p>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="contact-form__error" role="alert">
        <ul>
          {%- for field in form.errors -%}
            <li>{{ form.errors.messages[field] }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="contact-form__row">
      <label for="ContactName" class="field-label">Name</label>
      <input type="text" id="ContactName" name="contact[name]" class="field-input" value="{{ form.name }}" required>
    </div>
    <div class="contact-form__row">
      <label for="ContactEmail" class="field-label">Email</label>
      <input type="email" id="ContactEmail" name="contact[email]" class="field-input" value="{{ form.email }}" required>
    </div>
    <div class="contact-form__row">
      <label for="ContactMessage" class="field-label">Message</label>
      <textarea id="ContactMessage" name="contact[body]" class="field-input" rows="6" required>{{ form.body }}</textarea>
    </div>
    <button type="submit" class="btn btn--accent">Send message</button>
  {%- endform -%}
</div>

{% stylesheet %}
.contact-page__subheading { margin-top: 12px; max-width: 560px; color: var(--color-ink-secondary); }
.contact-form { max-width: 560px; }
.contact-form__row { margin-bottom: 20px; }
.contact-form textarea.field-input { resize: vertical; }
.contact-form__success { padding: 14px 16px; border-radius: var(--radius-sm); background: rgba(255,61,26,0.08); margin-bottom: 20px; }
.contact-form__error { padding: 14px 16px; border-radius: var(--radius-sm); background: rgba(255,61,26,0.08); margin-bottom: 20px; color: var(--color-accent); }
.contact-form__error ul { margin: 0; padding-left: 18px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ]
}
{% endschema %}

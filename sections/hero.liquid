<section class="hero dark-surface" style="{% if section.settings.image %}--hero-bg: url('{{ section.settings.image | image_url: width: 2000 }}');{% endif %}">
  <div class="hero__media">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {%- else -%}
      <div class="hero__media-placeholder">[PLACEHOLDER IMAGE]</div>
    {%- endif -%}
  </div>

  <div class="page-width hero__content">
    <p class="eyebrow">{{ section.settings.eyebrow | default: 'Beyond' }}</p>
    <h1 class="h1">{{ section.settings.heading | default: 'Go beyond your last personal best.' }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="hero__actions">
      {%- if section.settings.primary_link != blank -%}
        <a href="{{ section.settings.primary_link }}" class="btn btn--accent">{{ section.settings.primary_text | default: 'Shop performance running' }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_link != blank -%}
        <a href="{{ section.settings.secondary_link }}" class="btn btn--outline hero__btn-outline">{{ section.settings.secondary_text | default: 'Explore collections' }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.hero {
  position: relative;
  min-height: 640px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.hero__media {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hero__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.hero__media::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(10,10,10,0.15) 0%, rgba(10,10,10,0.85) 100%);
}
.hero__media-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a1a1a;
  color: var(--color-dark-ink-secondary);
  font-family: var(--font-heading);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.hero__content {
  position: relative;
  z-index: 1;
  padding-top: 120px;
  padding-bottom: 64px;
  max-width: 760px;
}
.hero__subheading {
  margin: 20px 0 0;
  font-size: 1.0625rem;
  max-width: 480px;
  color: var(--color-dark-ink-secondary);
}
.hero__actions {
  display: flex;
  gap: 12px;
  margin-top: 32px;
  flex-wrap: wrap;
}
.hero__btn-outline { color: var(--color-dark-ink); }
.hero__btn-outline:hover { color: var(--color-dark-surface); }

@media (max-width: 749px) {
  .hero { min-height: 520px; }
  .hero__content { padding-top: 96px; padding-bottom: 40px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Beyond"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Go beyond your last personal best."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "primary_text",
      "label": "Primary button label",
      "default": "Shop performance running"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "Secondary button label",
      "default": "Explore collections"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}

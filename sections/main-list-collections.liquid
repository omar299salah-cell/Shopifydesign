<div class="page-width list-collections section-padding" style="padding-top: 32px;">
  <div class="simple-page__header">
    <h1 class="h1">{{ section.settings.heading | default: 'Collections' }}</h1>
  </div>
  <div class="grid list-collections__grid">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="list-collections__item">
          <div class="list-collections__image">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" loading="lazy" width="800" height="1000">
            {%- else -%}
              <div class="featured-collections__placeholder">[PLACEHOLDER]</div>
            {%- endif -%}
          </div>
          <span class="featured-collections__title" style="color: var(--color-ink); position: static; text-shadow: none; display: block; margin-top: 10px;">{{ collection.title }}</span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
.list-collections__grid { grid-template-columns: repeat(2, 1fr); }
.list-collections__image { aspect-ratio: 4/5; border-radius: var(--radius-md); overflow: hidden; background: var(--color-border); }
.list-collections__image img { width: 100%; height: 100%; object-fit: cover; }
@media (min-width: 750px) {
  .list-collections__grid { grid-template-columns: repeat(3, 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}

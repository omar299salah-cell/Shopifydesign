{%- comment -%} Usage: {% render 'newsletter-form', id: 'Footer' %} {%- endcomment -%}
{%- form 'customer', id: 'NewsletterForm-' | append: id, class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">
  <div class="newsletter-form__row">
    <label for="NewsletterEmail-{{ id }}" class="visually-hidden">{{ 'general.newsletter.email_placeholder' | t }}</label>
    <input
      type="email"
      name="contact[email]"
      id="NewsletterEmail-{{ id }}"
      class="field-input"
      placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
      required
    >
    <button type="submit" class="btn btn--accent">{{ 'general.newsletter.submit' | t }}</button>
  </div>
  {%- if form.posted_successfully? -%}
    <p class="newsletter-form__message" role="status">{{ 'general.newsletter.success' | t }}</p>
  {%- elsif form.errors -%}
    <p class="newsletter-form__message newsletter-form__message--error" role="alert">{{ 'general.newsletter.error' | t }}</p>
  {%- endif -%}
{%- endform -%}

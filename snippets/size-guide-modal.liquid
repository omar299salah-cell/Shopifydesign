<div class="size-guide-modal" data-size-guide-modal hidden>
  <div class="size-guide-modal__overlay" data-size-guide-close></div>
  <div class="size-guide-modal__panel" role="dialog" aria-modal="true" aria-label="{{ 'products.product.size_guide' | t }}">
    <div class="size-guide-modal__header">
      <h2 class="h4">{{ 'products.product.size_guide' | t }}</h2>
      <button type="button" class="site-header__icon-btn" data-size-guide-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', icon: 'close', width: 20, height: 20 %}
      </button>
    </div>
    <div class="size-guide-modal__body">
      <p class="size-guide-modal__note">Fit runs true to size for most runners. If you're between sizes or prefer extra room in the toe box, size up half a size.</p>
      <div class="visually-scroll-x">
        <table class="size-guide-table">
          <thead>
            <tr><th>US (Men)</th><th>US (Women)</th><th>UK</th><th>EU</th><th>CM</th></tr>
          </thead>
          <tbody>
            <tr><td>6</td><td>7.5</td><td>5.5</td><td>39</td><td>24</td></tr>
            <tr><td>7</td><td>8.5</td><td>6.5</td><td>40</td><td>25</td></tr>
            <tr><td>8</td><td>9.5</td><td>7.5</td><td>41</td><td>26</td></tr>
            <tr><td>9</td><td>10.5</td><td>8.5</td><td>42.5</td><td>27</td></tr>
            <tr><td>10</td><td>11.5</td><td>9.5</td><td>44</td><td>28</td></tr>
            <tr><td>11</td><td>12.5</td><td>10.5</td><td>45</td><td>29</td></tr>
            <tr><td>12</td><td>13.5</td><td>11.5</td><td>46</td><td>30</td></tr>
          </tbody>
        </table>
      </div>
      <p class="size-guide-modal__disclaimer">[PLACEHOLDER — replace with brand-specific fit data once available.]</p>
    </div>
  </div>
</div>
